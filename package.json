{
  "name": "radioatlas",
  "version": "0.6.0",
  "private": true,
  "description": "Explore and listen to live radio stations from around the world.",
  "homepage": "https://github.com/liuuuuuu/RadioAtlas",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "geo:build": "node scripts/build-geo-data.mjs",
    "verify:globe": "node scripts/verify-globe-flow.mjs",
    "verify:stream": "node scripts/verify-stream-playback.mjs",
    "verify:library": "node scripts/verify-library.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "hls.js": "^1.7.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
