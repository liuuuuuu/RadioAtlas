# Radio Browser requires a descriptive User-Agent identifying your app.
# Set this in production so the directory operator can reach you if needed.
RADIO_BROWSER_USER_AGENT="RadioAtlas/0.4.0 (+https://github.com/liuuuuuu/RadioAtlas)"

# Audio relay for plain-HTTP stations (/api/stream).
# 71% of the directory's most-voted stations only publish http:// streams, which
# an HTTPS page cannot load at all. The relay makes them playable, at the cost of
# server bandwidth.
# Set to "0" to disable: HTTP stations will then be marked unplayable.
NEXT_PUBLIC_STREAM_PROXY=1
